# =============================================================================
# BiBongUt LLC — Environment Variables
# =============================================================================
#
# Copy this file to .env and fill in your Supabase project credentials.
#
#   cp .env.example .env
#
# These values are found in your Supabase dashboard:
#   Project Settings > API > Project URL and anon/public key
#
# The EXPO_PUBLIC_ prefix is required — Expo automatically inlines any
# env var with this prefix into the JS bundle at build time.
# Do NOT put secret keys here (e.g. service_role key) — they would be
# exposed in the client bundle.
#
# @see https://docs.expo.dev/guides/environment-variables/
# @see https://supabase.com/docs/guides/getting-started/quickstarts/reactnative
# =============================================================================

EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
